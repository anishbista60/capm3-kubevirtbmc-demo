# Pinned versions for the CAPM3 + KubeVirtBMC demo. Sourced by every script.
# Any of these can be overridden from the environment, e.g.
#   KUBEVIRTBMC_VERSION=v0.10.0 ./setup-platform.sh

# --- Management cluster platform ---------------------------------------------
: "${CERT_MANAGER_VERSION:=v1.21.2}"
: "${KUBEVIRT_VERSION:=v1.9.0}"
: "${CDI_VERSION:=v1.66.1}"
: "${MULTUS_VERSION:=v4.3.1}"
: "${CNI_PLUGINS_VERSION:=v1.9.1}"          # only the "bridge" plugin is used, on the kind node
: "${KUBEVIRTBMC_VERSION:=v0.11.0}"         # >= v0.11.0 needed for HTTPS virtual media (#293)

# --- Metal3 + Cluster API ----------------------------------------------------
: "${IRSO_VERSION:=v0.12.0}"
: "${BMO_VERSION:=v0.14.1}"
: "${CAPI_VERSION:=v1.14.3}"
: "${CAPM3_VERSION:=v1.14.1}"
: "${IPAM_VERSION:=v1.14.1}"

# --- Workload cluster ----------------------------------------------------------
: "${CALICO_VERSION:=v3.31.7}"

# Pinned in the manifests themselves, not here:
#   Ironic 39.0                      manifests/platform/05-ironic-vmedia-*.yaml
#   Ubuntu 24.04 node image          manifests/platform/06-image-server.yaml
#   Kubernetes v1.35.9, kube-vip     manifests/cluster/
#   Kubernetes v1.36.5 (upgrade)     manifests/upgrade/
